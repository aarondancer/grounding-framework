{
  "name": "grounding-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter='*' build",
    "dev": "bun run --filter='@grounding/web' dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "typecheck": "bun run --filter='*' typecheck",
    "migrate": "bun run --filter='@grounding/db' migrate",
    "compose:up": "docker compose -f ops/compose.yaml up -d",
    "compose:down": "docker compose -f ops/compose.yaml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "bun-types": "1.4.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
