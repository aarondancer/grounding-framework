{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "key",
    "name",
    "status",
    "semanticText"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "deprecated"
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "promptFragments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorization": {
      "$ref": "common.schema.json#/$defs/expression"
    },
    "applicability": {
      "$ref": "common.schema.json#/$defs/expression"
    },
    "selectionGroup": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "semanticText": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
